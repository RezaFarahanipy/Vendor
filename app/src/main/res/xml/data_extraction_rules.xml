<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules: Prevent sensitive database and vendor files from being extracted to the cloud.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vendorlist_database" />
        <exclude domain="database" path="vendorlist_database-shm" />
        <exclude domain="database" path="vendorlist_database-wal" />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vendorlist_database" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
