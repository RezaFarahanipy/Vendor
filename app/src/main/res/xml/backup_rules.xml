<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules file: Exclude all sensitive database files, photos and PDF catalogs
   from automatic cloud backup to protect sensitive vendor & financial data.
-->
<full-backup-content>
    <exclude domain="database" path="vendorlist_database" />
    <exclude domain="database" path="vendorlist_database-shm" />
    <exclude domain="database" path="vendorlist_database-wal" />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
